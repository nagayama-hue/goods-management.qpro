# このファイルを .env.local にコピーし、値を設定する（値の受け渡しは HANDOFF.md「環境変数と秘密情報」参照）
# AI 案出し・会議サマリー・ダッシュボード AI 機能に必須。未設定でも AI 機能以外は動作する
ANTHROPIC_API_KEY=

# ログイン（Basic 認証）。未設定だと全画面が 503 になる（設定漏れで公開状態に戻さないため）
# ローカル開発でも自分用の値を設定すること
GOODS_BASIC_USER=
GOODS_BASIC_PASS=

# 社内ポータル連携（/api/portal/* の Bearer 認証）。docs/portal-integration.md 段階2で使用
# 生成例: openssl rand -hex 32 。未設定だと /api/portal/* は 503
PORTAL_API_TOKEN=

# 大会編集画面の「ポータルの大会」候補をポータルから取得するため（未設定なら大会IDの手入力になる）
PORTAL_API_URL=
PORTAL_EVENTS_TOKEN=
